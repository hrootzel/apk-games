{
  "name": "vector-arcade",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build:web": "vite build",
    "build": "npm run typecheck && npm run build:web",
    "preview": "vite preview --host 0.0.0.0",
    "android:add": "cap add android",
    "android:sync": "cap sync android",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "bash ./scripts/test-e2e.sh",
    "test:ci": "npm run typecheck && npm run test:coverage && npm run build:web && npm run test:e2e",
    "test:e2e:plain": "playwright test"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "pixi.js": "^8.16.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "@playwright/test": "1.64.0",
    "@vitest/coverage-v8": "5.0.5",
    "vitest": "5.0.5"
  }
}
